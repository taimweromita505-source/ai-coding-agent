{
  "agent": {
    "name": "Local AI Coding Agent",
    "version": "3.2.0",
    "models": {
      "primary": "gpt-oss:20b",
      "fallback": "qwen2.5-coder:latest",
      "fast": "deepseek-coder:1.3b"
    },
    "providers": {
      "ollama": {
        "url": "http://localhost:11434",
        "api_key": null,
        "models_dir": "./models"
      },
      "openai": {
        "url": "https://api.openai.com/v1",
        "api_key": null
      },
      "anthropic": {
        "url": "https://api.anthropic.com",
        "api_key": null
      },
      "google": {
        "url": "https://generativelanguage.googleapis.com/v1beta",
        "api_key": null
      }
    },
    "workspace": "./workspace",
    "logs": "./logs",
    "max_iterations": 10,
    "temperature": 0.7,
    "memory": {
      "enabled": true,
      "max_history": 1000,
      "context_window": 4000,
      "auto_learn": true,
      "persist": true,
      "learning_rate": 0.1
    }
  }
}
