{
  "name": "ai-coding-agent",
  "displayName": "AI Coding Agent",
  "description": "Portable AI Coding Agent - No Restrictions",
  "version": "3.2.0",
  "publisher": "taimwe-romita",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Machine Learning",
    "Snippets",
    "Other"
  ],
  "activationEvents": [
    "onCommand:aiAgent.start",
    "onView:aiAgent.sidebar"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiAgent.start",
        "title": "Start AI Agent"
      },
      {
        "command": "aiAgent.chat",
        "title": "AI Agent Chat"
      },
      {
        "command": "aiAgent.explain",
        "title": "Explain Code"
      },
      {
        "command": "aiAgent.runAgentic",
        "title": "Run Agentic Task"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiAgent.sidebar",
          "title": "AI Agent",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "aiAgent.sidebar": [
        {
          "id": "aiAgent.chatView",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "AI Coding Agent",
      "properties": {
        "aiAgent.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama server URL"
        },
        "aiAgent.primaryModel": {
          "type": "string",
          "default": "gpt-oss:20b",
          "description": "Primary model"
        },
        "aiAgent.fallbackModel": {
          "type": "string",
          "default": "qwen2.5-coder:latest",
          "description": "Fallback model"
        },
        "aiAgent.fastModel": {
          "type": "string",
          "default": "deepseek-coder:1.3b",
          "description": "Fast model"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ./",
    "compile": "tsc -watch -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.3.0"
  }
}